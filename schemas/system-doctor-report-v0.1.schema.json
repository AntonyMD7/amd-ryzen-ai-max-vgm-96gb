{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dais/system-doctor-report-v0.1.schema.json",
  "title": "DAIS Universal System Doctor read-only report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collector",
    "system",
    "storage",
    "checks",
    "privacy",
    "mutation",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": {"const": "system_doctor.py"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "mode": {"const": "READ_ONLY"}
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "architecture", "python", "memory_total_bytes"],
      "properties": {
        "os": {"type": "string", "maxLength": 128},
        "release": {"type": "string", "maxLength": 256},
        "architecture": {"type": "string", "maxLength": 128},
        "python": {"type": "string", "maxLength": 128},
        "memory_total_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_headroom", "git_available", "python_available"],
      "properties": {
        "storage_headroom": {"$ref": "#/$defs/check"},
        "git_available": {"$ref": "#/$defs/check"},
        "python_available": {"$ref": "#/$defs/check"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username_collected",
        "hostname_collected",
        "network_addresses_collected",
        "environment_values_collected",
        "credentials_collected",
        "user_files_opened",
        "process_command_lines_collected"
      ],
      "properties": {
        "username_collected": {"const": false},
        "hostname_collected": {"const": false},
        "network_addresses_collected": {"const": false},
        "environment_values_collected": {"const": false},
        "credentials_collected": {"const": false},
        "user_files_opened": {"const": false},
        "process_command_lines_collected": {"const": false}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_changed",
        "software_installed",
        "services_changed",
        "configuration_changed",
        "reboot_requested"
      ],
      "properties": {
        "files_changed": {"const": false},
        "software_installed": {"const": false},
        "services_changed": {"const": false},
        "configuration_changed": {"const": false},
        "reboot_requested": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  },
  "$defs": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_bytes", "used_bytes", "free_bytes"],
      "properties": {
        "total_bytes": {"type": ["integer", "null"], "minimum": 0},
        "used_bytes": {"type": ["integer", "null"], "minimum": 0},
        "free_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["OK", "NOTICE", "REVIEW", "UNKNOWN"]},
        "summary": {"type": "string", "maxLength": 1000},
        "version": {"type": ["string", "null"], "maxLength": 240}
      }
    }
  }
}
