{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AntonyMD7/amd-ryzen-ai-max-vgm-96gb/schemas/hardware-compatibility-report-v0.1.schema.json",
  "title": "Hardware Compatibility Commons Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "hardware", "software", "configuration", "observation", "evidence", "privacy", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "report_id": {"type": "string", "minLength": 8},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "architecture"],
      "properties": {
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "accelerator": {"type": ["string", "null"]}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "kernel": {"type": ["string", "null"]},
        "driver": {"type": ["string", "null"]},
        "runtime": {"type": ["string", "null"]},
        "firmware": {"type": ["string", "null"]}
      }
    },
    "configuration": {"type": "object"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at_utc", "summary"],
      "properties": {
        "status": {"type": "string", "enum": ["VERIFIED", "DISCOVERY_ONLY", "COMMUNITY_REPORTED", "UNSUPPORTED", "UNKNOWN"]},
        "observed_at_utc": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "artifact_hashes"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "source_commit": {"type": ["string", "null"]},
        "artifact_hashes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets_removed", "personal_data_removed", "private_network_data_removed"],
      "properties": {
        "secrets_removed": {"const": true},
        "personal_data_removed": {"const": true},
        "private_network_data_removed": {"const": true}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
